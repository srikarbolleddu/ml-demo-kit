{
  "name": "@srikarbolleddu/ml-demo-kit",
  "version": "0.1.3",
  "description": "React components for live ML model demos: schema-driven prediction forms and interactive explore charts.",
  "type": "module",
  "main": "./dist/ml-demo-kit.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ml-demo-kit.js"
    },
    "./styles.css": "./dist/ml-demo-kit.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode lib",
    "build:site": "vite build --mode site",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "machine-learning",
    "demo",
    "react",
    "charts",
    "fastapi"
  ],
  "author": "Srikar Bolleddu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srikarbolleddu/ml-demo-kit.git"
  },
  "homepage": "https://github.com/srikarbolleddu/ml-demo-kit#readme",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
